# n3os.com — Apache config for shared hosting (BigRock)
# This only matters when deploying dist/ to Apache; Cloudflare Pages and
# similar static hosts ignore it entirely.

ErrorDocument 404 /404.html

# ---------------------------------------------------------------------------
# Clean URLs
# ---------------------------------------------------------------------------
# Rewrites (not redirects), so /about and /about.html both resolve and no
# existing link breaks. The canonical tags still point at the .html forms, so
# search engines only ever index one version of each page.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS. Leave commented if you terminate TLS at a proxy with
  # "Flexible" SSL (e.g. Cloudflare) — there it causes a redirect loop.
  # RewriteCond %{HTTPS} !=on
  # RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # "Pricing" in the nav lives at /subscriptions.html; let the obvious URL work.
  RewriteRule ^pricing/?$ /subscriptions.html [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([^.]+)/?$ /$1.html [L]
</IfModule>

# ---------------------------------------------------------------------------
# MIME types
# ---------------------------------------------------------------------------
# Without these, Apache serves fonts and WebP as application/octet-stream, which
# skips the compression and caching rules below and can break WebP negotiation.
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/webp .webp
  AddType image/svg+xml .svg
  AddType application/manifest+json .webmanifest
</IfModule>

# ---------------------------------------------------------------------------
# Compression
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript text/javascript
  AddOutputFilterByType DEFLATE application/json application/manifest+json
  AddOutputFilterByType DEFLATE image/svg+xml application/xml
  # Already-compressed formats: re-compressing costs CPU and saves nothing.
  SetEnvIfNoCase Request_URI \.(?:woff2?|png|jpe?g|webp|avif|ico)$ no-gzip dont-vary
</IfModule>

# ---------------------------------------------------------------------------
# Caching
# ---------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  # HTML must never be cached hard, or visitors keep loading a build that
  # references asset filenames that no longer exist.
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  # Vite fingerprints every JS/CSS filename, so those are safe to freeze.
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"

  # Content-Security-Policy
  # -----------------------
  # 'unsafe-inline' is required for scripts because of the theme bootstrap in
  # <head>, and for styles because Framer Motion animates via inline style
  # attributes. This still blocks script injection from external origins.
  #
  # To tighten script-src, swap 'unsafe-inline' for the hash of that inline
  # script. As generated by scripts/build-html-shells.py it is:
  #   'sha256-Xbr2TLkf932amZDMQkWWFA7r4bXO8zQbSEjuNs4w6m8='
  # Verify against the built dist/index.html before relying on it — if the hash
  # is wrong the theme script is blocked and dark mode flashes on load.
  #
  # connect-src allows https: so a form endpoint (Supabase, Formspree) works
  # without another edit; narrow it to your actual endpoint once it's chosen.
  Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https:; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
</IfModule>
